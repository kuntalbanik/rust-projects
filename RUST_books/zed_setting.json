// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "terminal": {
    "font_size": 10.0,
    "shell": {
      "program": "C:\\Program Files\\Git\\bin\\bash.exe"
    }
  },
  "proxy": "",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent": {
    "sidebar_side": "left",
    "cancel_generation_on_terminal_stop": false,
    "show_merge_conflict_indicator": false,
    "auto_compact": {
      "enabled": false
    },
    "expand_edit_card": false,
    "expand_terminal_card": false,
    "favorite_models": [],
    "model_parameters": [],
    "enable_feedback": false
  },
  "disable_ai": true,
  "auto_update": false,
  "base_keymap": "VSCode",
  "minimap": {
    "show": "always"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "dark",
    "light": "Gruvbox Light",
    "dark": "Ayu Dark",
  },
    "format_on_save": "off",
    "languages": {
      "JSON": {
        "formatter": "none"
      }
    },
      "title_bar": {
        "show_menus": true
      },
    "project_panel": {
    "dock": "left"
  },
}
